# Public, canonical HTTPS origin. Must exactly match the Google OAuth redirect URI.
APP_BASE_URL=https://assettracker.example.com

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated, lower-case Google Workspace/personal addresses permitted to use the dashboard.
# Production login intentionally denies all unlisted accounts; do not leave this empty.
GOOGLE_ALLOWED_EMAILS=admin@example.com,operator@example.com
GOOGLE_ADMIN_EMAILS=admin@example.com

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Railway: DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=
