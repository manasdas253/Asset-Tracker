# Canonical public HTTPS origin. Existing QR URLs and tokens stay unchanged.
# Set the permanent, phone-accessible origin before printing new labels.
APP_BASE_URL=https://assettracker.example.com

# Railway: DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=

# Set to 1 only when running behind one trusted reverse proxy (e.g. Railway).
TRUST_PROXY_HOPS=0

# Local account setup is CLI-only: pnpm.cmd auth:bootstrap create ADMIN001 "Workspace Admin"
# Sessions use opaque random cookies backed by MySQL, not OAuth or JWT secrets.
